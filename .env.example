# --- Telegram -----------------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_TOKEN=123456789:AAAA-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
TELEGRAM_CHAT_ID=123456789

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. Use the *service_role* key (server side only).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...service_role...

# --- Search centre (Madrid 28020) ---------------------------------------
WP_LATITUDE=40.44
WP_LONGITUDE=-3.70
WP_DEFAULT_DISTANCE_KM=100

# --- Margin model (all optional, these are the defaults) ----------------
SELLER_FEE=0
BUYER_FEE=0.075
BUYER_FIXED=0.69
SHIPPING_IN=4.50
TARGET_MARGIN=50

# Hard budget ceiling: never alert on a listing priced above this, however good
# the margin. Also clamps every search's API-side max price.
MAX_DEAL_PRICE=350

# Minimum number of comps before a learned ref_price replaces the seed
MIN_COMPS=5
# Trailing window for comps, in days
COMPS_WINDOW_DAYS=30
# Fraction trimmed off each end of the comps distribution before the median
TRIM_FRACTION=0.10

# --- Runtime ------------------------------------------------------------
# Pages fetched per search (alert loop / comps loop)
ALERT_MAX_PAGES=2
COMPS_MAX_PAGES=5
# Seconds between Telegram sends
TELEGRAM_RATE_DELAY=0.5
# Set to 1 to log alerts instead of sending them
DRY_RUN=0
