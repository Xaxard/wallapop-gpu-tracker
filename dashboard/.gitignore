# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — these hold the service-role key, the dashboard password and the
# session signing secret, and must never be committed.
.env*
# ...but .env.example is documentation, not configuration: it contains only
# placeholders, and README.md tells you to copy it to .env.local. Without this
# negation the blanket .env* rule above meant the one env file that is *supposed*
# to be tracked never could be.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
